function calculate() {
  const years = parseInt(document.getElementById("years").value);
  const type = document.getElementById("type").value;

  let result = "";

  if (type === "employee") {
    result = "4 Wochen Kündigungsfrist";
  } else {
    if (years < 2) result = "4 Wochen";
    else if (years < 5) result = "1 Monat";
    else if (years < 8) result = "2 Monate";
    else if (years < 10) result = "3 Monate";
    else result = "mehrere Monate";
  }

  document.getElementById("result").innerText = result;

  // 🔥 Affiliate Trigger
  if (years >= 2) {
    document.getElementById("affiliateBox").style.display = "block";
  }
}
